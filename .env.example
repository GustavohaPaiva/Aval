# =============================================================================
# Aval — variáveis de ambiente (exemplo)
# Copie para .env e preencha. No GitHub Actions, configure Secrets/Variables.
# =============================================================================

# --- Supabase (obrigatório) ---
# Produção (Syagri):      https://dnmjjgeqaigrvdsflqrs.supabase.co
# Testes (Syagri-Test):   https://uszbvqmquniuorxkqyat.supabase.co
# Local/dev: use Syagri-Test. GitHub Pages (produção): use Syagri.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- URL pública do app (canônica, SEM barra final) ---
VITE_APP_URL=https://aval-fertilizantes.online

# --- Base path do Vite (COM barra final) ---
# Domínio próprio (GitHub Pages + custom domain) = raiz:
VITE_BASE_PATH=/
# Só use subpath se NÃO tiver domínio próprio, ex. projeto Pages:
# VITE_BASE_PATH=/Syagri/

# --- Domínio de e-mail corporativo (com ou sem @) ---
VITE_AUTH_EMAIL_DOMAIN=syagri.com.br

# --- Opcional: assistente de texto (Gemini) — só desenvolvimento local ---
# NÃO use no deploy/GitHub Pages: a chave entra no JS público e o Push Protection
# bloqueia o push em gh-pages. O script build:pages zera VITE_GEMINI_API_KEY.
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.5-flash
