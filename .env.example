# =============================================================================
# Aval — variáveis de ambiente (exemplo)
# Copie para .env e preencha. No GitHub Actions, configure Secrets/Variables.
# =============================================================================

# --- Supabase (obrigatório) ---
# Produção (Syagri):      https://dnmjjgeqaigrvdsflqrs.supabase.co
# Testes (Syagri-Test):   https://uszbvqmquniuorxkqyat.supabase.co
# Local/dev: use Syagri-Test. GitHub Pages (produção): use Syagri.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- URL pública do app (canônica, SEM barra final) ---
VITE_APP_URL=https://aval-fertilizantes.online

# --- Base path do Vite (COM barra final) ---
# Domínio próprio (GitHub Pages + custom domain) = raiz:
VITE_BASE_PATH=/
# Só use subpath se NÃO tiver domínio próprio, ex. projeto Pages:
# VITE_BASE_PATH=/Syagri/

# --- Domínio de e-mail corporativo (com ou sem @) ---
VITE_AUTH_EMAIL_DOMAIN=syagri.com.br

# --- Assistente de texto (Gemini) ---
# Produção: NÃO use VITE_GEMINI_API_KEY (entra no JS e o Push Protection bloqueia
# o gh-pages). Configure secrets no projeto Supabase (Edge Function):
#   npx supabase secrets set GEMINI_API_KEY=sua_chave --project-ref dnmjjgeqaigrvdsflqrs
#   npx supabase secrets set GEMINI_MODEL=gemini-2.5-flash --project-ref dnmjjgeqaigrvdsflqrs
# (Syagri-Test: uszbvqmquniuorxkqyat). Function: melhorar-texto-proposta.
# Local opcional (fallback direto, sem Edge Function):
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.5-flash

# --- Web Push (chave pública; pode ir no frontend) ---
# A mesma chave pública configurada no segredo VAPID_PUBLIC_KEY da Edge Function.
# Se ficar vazia, o app pede a chave à function enviar-push-notificacao.
# Gere o par com: node scripts/generate-vapid-keys.mjs
# Não coloque VAPID_PRIVATE_KEY aqui.
VITE_VAPID_PUBLIC_KEY=

# Segredos da Edge Function enviar-push-notificacao (supabase secrets set, nunca no repositório):
#   VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY
#   VAPID_SUBJECT=mailto:ops@syagri.com.br
#
# Vault do Postgres (SQL editor, depois da migration). O trigger lê estes nomes:
#   select vault.create_secret(
#     'https://PROJECT.supabase.co/functions/v1/enviar-push-notificacao',
#     'push_function_url',
#     'URL da edge function de push'
#   );
#   select vault.create_secret(
#     'SERVICE_ROLE_JWT_LEGADO',
#     'push_dispatch_key',
#     'JWT service_role. Não use a chave sb_secret nova no header Authorization.'
#   );
#
# Syagri-Test:  --project-ref uszbvqmquniuorxkqyat
# Produção:     --project-ref dnmjjgeqaigrvdsflqrs  (só com autorização explícita)
# Deploy: npx supabase functions deploy enviar-push-notificacao --project-ref uszbvqmquniuorxkqyat
# verify_jwt permanece true: o banco envia o JWT service_role; o usuário autenticado só pode ler a chave pública.
