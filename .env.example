# =============================================================================
# Aval — variáveis de ambiente (exemplo)
# Copie para .env e preencha. No GitHub Actions, configure Secrets/Variables.
# =============================================================================

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# --- URL pública do app (canônica, SEM barra final) ---
# Atual (GitHub Pages projeto):
VITE_APP_URL=https://gustavohapaiva.github.io/Syagri
# Futuro (domínio próprio na raiz), exemplo:
# VITE_APP_URL=https://app.seudominio.com.br

# --- Base path do Vite (COM barra final) ---
# GitHub Pages em repositório/projeto:
VITE_BASE_PATH=/Syagri/
# Domínio próprio servindo na raiz:
# VITE_BASE_PATH=/

# --- Domínio de e-mail corporativo (com ou sem @) ---
# Usado no login curto e na UI de consultores. NÃO muda sozinho no Auth do Supabase:
# contas já criadas continuam com o e-mail antigo até migração explícita.
VITE_AUTH_EMAIL_DOMAIN=syagri.com.br
# Futuro, exemplo:
# VITE_AUTH_EMAIL_DOMAIN=aval.com.br

# --- Opcional: assistente de texto (Gemini) ---
# VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-2.5-flash
